# LLM provider (DB settings via the Settings UI take effect too; env wins)
LLM_PROVIDER=openai
LLM_MODEL=
LLM_API_KEY=
LLM_API_BASE=
# e.g. Ollama: LLM_PROVIDER=ollama LLM_MODEL=llama3.1 LLM_API_BASE=http://localhost:11434/v1

# LLM call timeout in ms (default 180000; local models may need more)
LLM_TIMEOUT_MS=

# Where the SQLite database lives (default ./data)
DATA_DIR=
